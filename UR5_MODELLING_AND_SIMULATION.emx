 description '<Information>
  <Description>
    <Version>5.1</Version>
    <IsMainModel>0</IsMainModel>
    <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>C:\UNIVERSITA\MAGISTRALE\PRIMO ANNO\MSMS\EXAM.emx</LibraryPath>
    <TimeStamp>2026-6-25 12:05:37</TimeStamp>
  </Description>
  <Attributes>
    <GlobalRelations>parameters 
// Gravity on/off
	real gravity_on = 1;

// Control settings
	real gravity_flag=1;
	real control_flag=1;   

// Pick &amp; place 

	real pp_flag = 1;

// Geometric parameters

	real d[6,1] = [0.089159; 0; 0; 0.10915; 0.09465; 0.0823];

	real a[6,1] = [0; -0.425; -0.39225; 0; 0; 0];

	real alpha[6,1] = [pi/2; 0; 0; pi/2; -pi/2; 0];

	real theta0[6,1] = [0;0;0;0;0;0]; // initial joint angles                      

	real rG1[3,1] = [0; -0.02561; 0.00193];

	real rG2[3,1] = [0.2125; 0; 0.11336];

	real rG3[3,1] = [0.15; 0; 0.0265];

	real rG4[3,1] = [0; -0.0018; 0.01634];
	
	real rG5[3,1] = [0.0; 0.0018; 0.01634];
	
	real rG6[3,1] = [0.0;0.0; -0.001159];

// MASSES //

	real	m [6,1] = [3.7;8.393;2.33;1.1219;1.1219;0.1879];

	real box_mass = 3;

// MOMENT OF INERTIAS //

	real  J1 [3,3] = [0.0067, 0, 0;
							0, 0.0064, 0;
							0, 0, 0.0067];

	real  J2 [3,3] = [0.0149, 0, 0;
							0, 0.3564, 0;
							0, 0, 0.3553];
/*
	real  J3 [3,3] = [0.0025, 0,  0.0034;
							0,  0.0551, 0;
							0.0034, 0,  0.0546];
*/
	real  J3 [3,3] = [0.0023, 0,  0;
							0,  0.0548, 0;
							0, 0,  0.0551];

	real  J4 [3,3] = [0.0012, 0, 0;
							0, 0.0012, 0;
							0, 0, 0.0009];

	real  J5 [3,3] = [0.0012, 0, 0;
							0, 0.0012, 0;
							0, 0, 0.0009];

	real  J6 [3,3] = [0.0001, 0, 0;
							0, 0.0001, 0;
							0, 0, 0.0001];

	real H10[4,4];
	real H20[4,4];
	real H30[4,4];
	real H40[4,4];
	real H50[4,4];
	real H60[4,4]; 


initialequations

    H10 = [cos(theta0[1,1]), -sin(theta0[1,1])*cos(alpha[1,1]),  sin(theta0[1,1])*sin(alpha[1,1]), a[1,1]*cos(theta0[1,1]);
          sin(theta0[1,1]),  cos(theta0[1,1])*cos(alpha[1,1]), -cos(theta0[1,1])*sin(alpha[1,1]), a[1,1]*sin(theta0[1,1]);
          0,                 sin(alpha[1,1]),                  cos(alpha[1,1]),                  d[1,1];
          0,                 0,                                0,                                1];

    H20 = H10*[cos(theta0[2,1]), -sin(theta0[2,1])*cos(alpha[2,1]),  sin(theta0[2,1])*sin(alpha[2,1]), a[2,1]*cos(theta0[2,1]);
             sin(theta0[2,1]),  cos(theta0[2,1])*cos(alpha[2,1]), -cos(theta0[2,1])*sin(alpha[2,1]), a[2,1]*sin(theta0[2,1]);
             0,                 sin(alpha[2,1]),                  cos(alpha[2,1]),                  d[2,1];
             0,                 0,                                0,                                1];

    H30 = H20*[cos(theta0[3,1]), -sin(theta0[3,1])*cos(alpha[3,1]),  sin(theta0[3,1])*sin(alpha[3,1]), a[3,1]*cos(theta0[3,1]);
             sin(theta0[3,1]),  cos(theta0[3,1])*cos(alpha[3,1]), -cos(theta0[3,1])*sin(alpha[3,1]), a[3,1]*sin(theta0[3,1]);
             0,                 sin(alpha[3,1]),                  cos(alpha[3,1]),                  d[3,1];
             0,                 0,                                0,                                1];

    H40 = H30*[cos(theta0[4,1]), -sin(theta0[4,1])*cos(alpha[4,1]),  sin(theta0[4,1])*sin(alpha[4,1]), a[4,1]*cos(theta0[4,1]);
             sin(theta0[4,1]),  cos(theta0[4,1])*cos(alpha[4,1]), -cos(theta0[4,1])*sin(alpha[4,1]), a[4,1]*sin(theta0[4,1]);
             0,                 sin(alpha[4,1]),                  cos(alpha[4,1]),                  d[4,1];
             0,                 0,                                0,                                1];

    H50 = H40*[cos(theta0[5,1]), -sin(theta0[5,1])*cos(alpha[5,1]),  sin(theta0[5,1])*sin(alpha[5,1]), a[5,1]*cos(theta0[5,1]);
             sin(theta0[5,1]),  cos(theta0[5,1])*cos(alpha[5,1]), -cos(theta0[5,1])*sin(alpha[5,1]), a[5,1]*sin(theta0[5,1]);
             0,                 sin(alpha[5,1]),                  cos(alpha[5,1]),                  d[5,1];
             0,                 0,                                0,                                1];

    H60 = H50*[cos(theta0[6,1]), -sin(theta0[6,1])*cos(alpha[6,1]),  sin(theta0[6,1])*sin(alpha[6,1]), a[6,1]*cos(theta0[6,1]);
             sin(theta0[6,1]),  cos(theta0[6,1])*cos(alpha[6,1]), -cos(theta0[6,1])*sin(alpha[6,1]), a[6,1]*sin(theta0[6,1]);
             0,                 sin(alpha[6,1]),                  cos(alpha[6,1]),                  d[6,1];
             0,                 0,                                0,                                1];</GlobalRelations>
  </Attributes>
</Information>';
 type 'Mainmodel-16F5'
 end;
