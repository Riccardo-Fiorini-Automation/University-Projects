   C 1504 -8
    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Bond Graph\3D\C-3.emx</LibraryPath>
  <TimeStamp>2007-9-25 12:12:8</TimeStamp>
</Description>';
    type 'C-3'
     ports
      power in p [3,1];
      signal in presence;
     restrictions
      causality preferred out p;
    end;
    icon bg ellipse bottom
     figures
      text 'C' 1504 -8 color 0 18 bold;
    end;
    implementation eq
/*
parameters
	real c[3,3] = [0.0001, 0.0, 0.0; 0.0, 0.0001, 0.0; 0.0, 0.0, 0.0001];
equations
    state = int(p.f)*presence;
    p.e = inverse(c) *state; */

parameters
    real c[3,3] = [0.0001, 0.0, 0.0;
                   0.0, 0.0001, 0.0;
                   0.0, 0.0, 0.0001];

    real reset_gain = 1000;
    real state0[3,1] = [0;0;0];

variables
    real state_c[3,1];
    real state_dot[3,1];

equations
    if presence == 1 then
        state_dot = p.f;
    else
        state_dot = -reset_gain*state_c;
    end;

    state_c = int(state_dot, state0);

    if presence == 1 then
        p.e = inverse(c)*state_c;
    else
        p.e = [0;0;0];
    end;implementation_end;
