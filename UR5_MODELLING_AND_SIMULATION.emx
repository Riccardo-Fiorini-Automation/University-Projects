       end;
       icon bg ellipse bottom
        figures
         text 'MTF' 312 152 color 0 18 bold;
       end;
       implementation eq
variables 
	real R_theta[3,3];
	 

equations
	R_theta = [cos(theta), -sin(theta),			0;
					 sin(theta), cos(theta), 			0;
					 0,				 		0			,			1];
	
	p1.f = R_theta*p2.f;
	p2.e = transpose(R_theta)*p1.e;implementation_end;
      plug theta_dot_exit 272 256;
      plug H2 528 296;
      plug theta 504 232;
      plug linear_B 32 32;
      plug theta_dot 152 288;
      plug linear_A 472 32;
      plug angular_A 544 152;
