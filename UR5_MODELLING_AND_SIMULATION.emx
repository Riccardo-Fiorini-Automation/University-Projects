      R_alpha11 320 -8
       description '<Information><Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><LibraryPath>Bond Graph\3D\TF-3.emx</LibraryPath><TimeStamp>2007-9-25 12:11:35</TimeStamp><AllowLibraryUpdate>True</AllowLibraryUpdate></Description></Information>';
       type 'TF-3'
        ports
         power in p1 [3,1];
         power out p2 [3,1];
        restrictions
         causality constraint not_equal p1 p2;
       end;
       icon bg ellipse bottom
        figures
         text 'TF' 320 -8 color 0 18 bold;
       end;
       implementation eq
parameters
	
	real global alpha[6,1];
	real R_alpha[3,3];
	
initialequations 

	R_alpha = [1,0,0;
		0, cos(alpha[1,1]), -sin(alpha[1,1]);
		0, sin(alpha[1,1]), cos(alpha[1,1])]; 
	
equations

	p2.e = R_alpha*p1.e;
	p1.f = transpose (R_alpha)*p2.f;

implementation_end;
