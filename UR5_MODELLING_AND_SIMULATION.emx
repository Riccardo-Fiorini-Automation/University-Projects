       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal in theta;
         signal out H [4,4];
         signal in H1 [4,4];
       end;
       implementation eq
parameters
	real global alpha[6,1];
	real global a[6,1];
	real global d[6,1];
	real global rG2[3,1];
	
	real T_G[4,4] = [1 , 0 , 0 , rG2[1,1];
						  0 , 1 , 0 , rG2[2,1];
						  0 , 0 , 1 , rG2[3,1];
					  0 , 0 , 0 , 1]; 
					
variables
	real OG2[4,4];
	
equations
	H = H1*[cos(theta), -sin(theta)*cos(alpha[2,1]),  sin(theta)*sin(alpha[2,1]), a[2,1]*cos(theta);
          sin(theta),  cos(theta)*cos(alpha[2,1]), -cos(theta)*sin(alpha[2,1]), a[2,1]*sin(theta);
          0,                 sin(alpha[2,1]),                  cos(alpha[2,1]),                  d[2,1];
          0,                 0,                                0,                                1];

 OG2 = H*T_G;implementation_end;
