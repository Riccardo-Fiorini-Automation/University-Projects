   Pick_and_place 752 -96
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Submodel-Equation'
     ports
      signal in theta1;
      signal in theta2;
      signal in theta3;
      signal in theta4;
      signal in theta5;
      signal in theta6;
      signal out output;
    end;
    icon bg
     figures
      rectangle 696 -112 808 -80 color 0 fill 65535;
      text 'name' 752 -96 color 0 16;
    end;
    implementation eq
parameters
	
	real delta = 0.044; // 2,5 gradi
	real theta_desired[6,1] = [-pi/2;
												-pi/2;
        								   -pi/2;
       									   -pi/2;
       									   -pi/2;
       									   -pi/2];
	real global pp_flag;
	
variables
	
	real check;
	real theta[6,1];

initialequations
	
	check = 0;
	
equations
	
	theta = [theta1;theta2;theta3;theta4;theta5;theta6];	
	if abs(theta[1,1]-theta_desired[1,1])<= delta and abs(theta[2,1]-theta_desired[2,1])<= delta and abs(theta[3,1]-theta_desired[3,1])<= delta and abs(theta[4,1]-theta_desired[4,1])<= delta and abs(theta[5,1]-theta_desired[5,1])<= delta and abs(theta[6,1]-theta_desired[6,1])<= delta then
		output = 0;
		check = 0;
	elsif  pp_flag ==1 and abs(theta[1,1])<=delta and abs(theta[2,1])<=delta and abs(theta[3,1])<=delta and abs(theta[4,1])<=delta and abs(theta[5,1])<=delta and abs(theta[6,1])<=delta then
		output = 1;
		check = 1;
	else
		output = check;
	end;

 implementation_end;
