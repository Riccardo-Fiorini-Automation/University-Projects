   Gravity_compensation 760 240
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Gravity_compensation-Equation'
     ports
      signal in theta1;
      signal in theta2;
      signal in theta3;
      signal in theta4;
      signal in theta5;
      signal in theta6;
      signal out g1;
      signal out g2;
      signal out g3;
      signal out g4;
      signal out g5;
      signal out g6;
    end;
    icon bg
     figures
      rectangle 688 224 832 256 color 0 fill 13688896;
      text 'name' 760 240 color 0 16;
    end;
    implementation eq
parameters
	
	real global gravity_flag;

equations
	
	if gravity_flag==1 then
 		g1 = 0;
		g2 = -1/100*(1.3761958*sin(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) - 14.894296*cos(theta2)*cos(theta3) - 0.32940253*cos(theta5)*(6.123234e-17*sin(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) + 6.123234e-17*cos(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2))) - 37.348975*cos(theta2) + 14.894296*sin(theta2)*sin(theta3) + 1.3761958*cos(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2)) - 0.32940253*sin(theta5)*(cos(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) - 1.0*sin(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2))));
		g3 = -1/100*(1.3761958*sin(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) - 0.32940253*cos(theta5)*(6.123234e-17*sin(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) + 6.123234e-17*cos(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2))) - 14.894296*cos(theta2)*cos(theta3) + 14.894296*sin(theta2)*sin(theta3) + 1.3761958*cos(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2)) - 0.32940253*sin(theta5)*(cos(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) - 1.0*sin(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2))));
		g4 = -1/100*(1.3761958*sin(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) - 0.32940253*cos(theta5)*(6.123234e-17*sin(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) + 6.123234e-17*cos(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2))) + 1.3761958*cos(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2)) - 0.32940253*sin(theta5)*(cos(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) - 1.0*sin(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2))));
 		g5 = -1/100*(- 0.32940253*sin(theta5)*(6.123234e-17*cos(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) - 6.123234e-17*sin(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2)) + 6.123234e-17) - 0.32940253*cos(theta5)*(sin(theta4)*(cos(theta2)*cos(theta3) - 1.0*sin(theta2)*sin(theta3)) + cos(theta4)*(cos(theta2)*sin(theta3) + cos(theta3)*sin(theta2))));
		g6 = 0;
 	else
		g1 =0;
		g2=0;
		g3=0;
		g4=0;
		g5=0;
		g6=0;
	end;implementation_end;
   HD1 216 96
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
