        restrictions
         causality preferred in p;
       end;
       icon bg ellipse bottom
        figures
         text 'I' 224 56 color 0 18 bold;
       end;
       implementation eq
parameters
	real i = 0.091e-4;
equations
    state = int(p.e);
    p.f = state / i;
implementation_end;
