	flow = first (p.f);
implementation_end;
      R 456 240
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\R.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:35:37</TimeStamp>
</Description>
</Information>';
       type R
        ports
         power in p;
       end;
       icon bg ellipse bottom
        figures
         text 'R' 456 240 color 0 18 bold;
       end;
       implementation eq
parameters
	
	real bv = 6.4e-4;
	real bs1 = 0.008;
	real bs2 = -0.007;
	
equations

p.e = bv*p.f + bs2 + (bs1-bs2)/pi*(arctan (p.f)+pi/2);
implementation_end;
