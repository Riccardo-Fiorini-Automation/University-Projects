      OG3 496 304
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal in theta;
         signal out H [4,4];
         signal in H2 [4,4];
       end;
       implementation eq
parameters
	real global alpha[6,1];
	real global a[6,1];
	real global d[6,1];
	real global rG3[3,1];
	
	real T_G[4,4] = [1 , 0 , 0 , rG3[1,1];
						  0 , 1 , 0 , rG3[2,1];
						  0 , 0 , 1 , rG3[3,1];
					  0 , 0 , 0 , 1]; 
					
variables
	
	real OG3[4,4];

equations
	H = H2*[cos(theta), -sin(theta)*cos(alpha[3,1]),  sin(theta)*sin(alpha[3,1]), a[3,1]*cos(theta);
          sin(theta),  cos(theta)*cos(alpha[3,1]), -cos(theta)*sin(alpha[3,1]), a[3,1]*sin(theta);
          0,                 sin(alpha[3,1]),                  cos(alpha[3,1]),                  d[3,1];
          0,                 0,                                0,                                1];

	OG3 = H*T_G;implementation_end;
