   I 1664 32
    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Bond Graph\3D\I-3.emx</LibraryPath>
  <TimeStamp>2007-9-25 12:12:14</TimeStamp>
</Description>';
    type 'I-3'
     ports
      power in p [3,1];
      signal in presence;
     restrictions
      causality preferred in p;
    end;
    icon bg ellipse bottom
     figures
      text 'I' 1664 32 color 0 18 bold;
    end;
    implementation eq
parameters
    real global box_mass;
    real reset_gain = 1000;
 
    real i[3,3] = [box_mass, 0.0, 0.0;
                   0.0, box_mass, 0.0;
                   0.0, 0.0, box_mass];
 
    real state0[3,1] = [0;0;0];
 
variables
    real state_payload[3,1];
    real state_dot[3,1];
 
equations
    if presence == 1 then
        
        state_dot = p.e;
    else
        
        state_dot = -reset_gain*state_payload;
    end;
 
    state_payload = int(state_dot, state0);
 
    if presence == 1 then
        p.f = inverse(i)*state_payload;
    else
        p.f = [0;0;0];
    end;implementation_end;
