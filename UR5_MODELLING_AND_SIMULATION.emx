      EE 416 168
       description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
       type 'Submodel-Equation'
        ports
         signal out R_OG [3,3];
         power in angular_G [3,1];
         power in linear_G [3,1];
       end;
       implementation eq
parameters
	
	real global J1 [3,3];
	real global m [6,1];
   real global H10[4,4];
	real global rG1[3,1];
	real R_OG_0[3,3];

variables
	
    real p[3];
    real h[3];

initialequations
	
	R_OG_0 = H10[1:3,1:3];

equations
	
	angular_G.f = inverse(J1)*h;
	linear_G.f = p/m[1,1];
	p = int(linear_G.e-skew(angular_G.f)*p);
	h = int(angular_G.e-skew(angular_G.f)*h);
	R_OG = int(R_OG*skew(angular_G.f), R_OG_0);
	







	


	


   
 implementation_end;
      plug Angular_B 640 -56;
