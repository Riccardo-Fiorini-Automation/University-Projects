     connections
      angular_B => PowerDemux1\input;
      FlowSensor1\flow -> Splitter1\input;
      FlowSensor1\p2 => ZeroJunction3\p;
      Integrate\output1 -> MTF1\theta;
      Integrate\output2 -> MTF\theta;
      Integrate\theta -> Splitter2\input;
      linear_B => ZeroJunction\p;
      MTF\p2 => linear_A;
      MTF1\p2 => angular_A;
      OG1\H -> H1;
      PowerDemux1\output1 => ZeroJunction1\p;
      PowerDemux1\output2 => ZeroJunction2\p;
      PowerDemux1\output3 => ZeroJunction3\p;
      PowerMux1\output => MTF1\p1;
