       type Integrate
        ports
         signal in input;
         signal out output1;
         signal out output2;
         signal out theta;
       end;
       icon bg bottom
        figures
         rectangle 344 216 376 248 color 0 fill 15132390;
         text '∫' 360 232.3 color 16711680 'Lucida Sans' 21 italic;
       end;
       implementation eq
parameters
	
	real global theta0[6,1];

equations
	
	output1 = int(input, theta0[2,1]);
	output2 = output1;
	theta = output1;implementation_end;
      MTF 304 32
       description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Bond Graph\3D\MTF-3.emx</LibraryPath>
  <TimeStamp>2007-9-25 12:11:21</TimeStamp>
</Description>';
       type 'MTF-3'
        ports
         power in p1 [3,1];
         power out p2 [3,1];
         signal in theta;
        restrictions
         causality constraint not_equal p1 p2;
       end;
       icon bg ellipse bottom
        figures
         text 'MTF' 304 32 color 0 18 bold;
       end;
       implementation eq
variables 
	 real R_theta[3,3];
	 

equations
	R_theta = [cos(theta), -sin(theta),			0;
					 sin(theta), cos(theta), 			0;
					 0,				 		0			,			1];
	
	p1.f = R_theta*p2.f;
	p2.e = transpose(R_theta)*p1.e;implementation_end;
      MTF1 312 152
       description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Bond Graph\3D\MTF-3.emx</LibraryPath>
