    implementation bg
     submodels
      C 528 64
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\C.emx</LibraryPath>
  <TimeStamp>2011-11-29 15:58:35</TimeStamp>
</Description>
</Information>';
       type C
        ports
         power in p;
         signal out state;
        restrictions
         causality preferred out p;
       end;
       icon bg ellipse bottom
        figures
         text 'C' 528 64 color 0 18 bold;
       end;
       implementation eq
variables
   real phi1;
   real phi2;

parameters
	real k1 = 16e3;
	real k2 = 25e3;
	real k3 = 29e3;
	real T1 = 7;
	real T2 = 25;

equations
    state = int(p.f); // state = phi = torsion angle

    phi1 = T1/k1;
    phi2 = T1/k1 + (T2-T1)/k2; 

    if abs(state) <= phi1 then
        // first region
        p.e = k1*state;

    elsif abs(state) <= phi2 then
        // second region
        p.e = sign(state)*(T1 + k2*(abs(state)-phi1));

    else
        // third region
        p.e = sign(state)*(T2 + k3*(abs(state)-phi2));
    end;
implementation_end;
      I1 224 56
       description '<Information>
 <Description>
